print 14;                  // expect: 14
print -3;                  // expect: -3
print 0;                   // expect: 0
print 12.75;               // expect: 12.75
print 10 / 2;              // expect: 5
print 7 / 2;               // expect: 3.5
print 1 / 3;               // expect: 0.3333333333333333
print 0.1 + 0.2;           // expect: 0.30000000000000004
print 1000000 * 1000000;   // expect: 1000000000000
