print 2 + 3 * 4;           // expect: 14
print (2 + 3) * 4;         // expect: 20
print 10 - 2 - 3;          // expect: 5
print 10 / 2 / 5;          // expect: 1
print -3 + 5;              // expect: 2
print - -3;                // expect: 3
print 1 + 2 * 3 - 4 / 2;   // expect: 5
print 2 * 3 + 4 * 5;       // expect: 26
